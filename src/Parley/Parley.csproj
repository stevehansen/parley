<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parley</ToolCommandName>
    <PackageId>HC.Parley</PackageId>
    <Version>0.1.2</Version>

    <Authors>Steve Hansen</Authors>
    <Description>Pub/sub topics for AI coding agents — lets Claude Code sessions message each other, with push delivery via Claude Code channels.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stevehansen/parley</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevehansen/parley</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;mcp;claude-code;agents;collaboration;pubsub</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parley.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="Parley.Web.index.html" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
